diff --git a/launcher/app/src/main/java/com/gathin/tvhome/AnimationScale.java b/launcher/app/src/main/java/com/gathin/tvhome/AnimationScale.java
new file mode 100644
index 00000000..8bb1bcb4
--- /dev/null
+++ b/launcher/app/src/main/java/com/gathin/tvhome/AnimationScale.java
@@ -0,0 +1,84 @@
+package com.gathin.tvhome;
+
+import android.Manifest;
+import android.content.ContentResolver;
+import android.content.Context;
+import android.content.pm.PackageManager;
+import android.os.Handler;
+import android.os.Looper;
+import android.provider.Settings;
+
+/**
+ * Local addition (Toshiba 55M550LP): the firmware's system_server writes the three animation scales back to 1.0 on
+ * every boot (`dumpsys settings` shows pkg:android). config.xml's system_animation_scale, when set, is put back each
+ * time Home resumes. Needs WRITE_SECURE_SETTINGS, granted over ADB (install with RESTORE_KEY_SERVICES=1); without it
+ * this does nothing. Only writes when a value differs, so a normal resume costs three settings reads.
+ */
+final class AnimationScale {
+    private static final String TAG = "AnimationScale";
+    private static final String[] KEYS = {
+            Settings.Global.WINDOW_ANIMATION_SCALE,
+            Settings.Global.TRANSITION_ANIMATION_SCALE,
+            Settings.Global.ANIMATOR_DURATION_SCALE,
+    };
+
+    /** The firmware zeroes window/transition scales while an app starts, then writes 1.0 back ~3 s later. */
+    private static final long SECOND_PASS_MS = 5000;
+    private static final Handler HANDLER = new Handler(Looper.getMainLooper());
+    private static Runnable pending;
+
+    private AnimationScale() {
+    }
+
+    /** Applies now (catches the boot reset) and once more after the firmware's post-launch restore. */
+    static void applyNowAndLater(Context context) {
+        apply(context);
+        cancel();
+        final Context app = context.getApplicationContext();
+        pending = new Runnable() {
+            @Override
+            public void run() {
+                pending = null;
+                apply(app);
+            }
+        };
+        HANDLER.postDelayed(pending, SECOND_PASS_MS);
+    }
+
+    /** Home was left before the second pass: an app is starting, and the firmware owns the scales for now. */
+    static void cancel() {
+        if (pending != null) HANDLER.removeCallbacks(pending);
+        pending = null;
+    }
+
+    static void apply(Context context) {
+        String value = context.getString(R.string.system_animation_scale).trim();
+        if (value.isEmpty()) return;
+        float target;
+        try {
+            target = Float.parseFloat(value);
+        } catch (NumberFormatException e) {
+            return;
+        }
+        if (target < 0f || target > 10f) return;
+        if (context.checkSelfPermission(Manifest.permission.WRITE_SECURE_SETTINGS)
+                != PackageManager.PERMISSION_GRANTED) {
+            android.util.Log.i(TAG, "no WRITE_SECURE_SETTINGS; leaving the scales alone");
+            return;
+        }
+        ContentResolver resolver = context.getContentResolver();
+        for (String key : KEYS) {
+            try {
+                float before = Settings.Global.getFloat(resolver, key, 1f);
+                if (before != target) {
+                    boolean ok = Settings.Global.putFloat(resolver, key, target);
+                    android.util.Log.i(TAG, key + " " + before + " -> " + target + " put=" + ok
+                            + " now=" + Settings.Global.getFloat(resolver, key, -1f));
+                }
+            } catch (RuntimeException e) {
+                android.util.Log.w(TAG, key + " write failed", e);
+                return;
+            }
+        }
+    }
+}
